# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5435
DB_USERNAME=carely_user
DB_PASSWORD=carely_secret_password
DB_NAME=carely_db

# Redis (Caching & Redlock)
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth (JWT)
JWT_SECRET=super_carely_jwt_secret_key_production_grade_32chars
JWT_EXPIRATION=7d

# Firebase (Authentication & Cloud Messaging - FCM)
FIREBASE_PROJECT_ID=carely-mock
FIREBASE_CLIENT_EMAIL=mock@carely.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=""

# Third-party Identity Audience Validation (Mobile Client / Bundle ID)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
APPLE_CLIENT_ID=com.carely.app
