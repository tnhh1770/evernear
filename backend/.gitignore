# ==============================================================================
# Carely Backend (NestJS / Node.js / TypeScript) .gitignore
# ==============================================================================

# Compiled Output & Build Caches
/dist/
/build/
*.tsbuildinfo

# Dependencies
/node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Unit & Integration Test Coverage & Results
coverage/
.nyc_output/
test_results.txt
test-results/

# Environment Variables & Secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Firebase Admin SDK & Cloud Credentials
serviceAccountKey.json
*firebase-adminsdk*.json
*service-account*.json

# Local Databases & Storage Dumps
*.sqlite
*.sqlite3
*.db
*.db-journal
uploads/
temp/

# IDE & OS Files
.DS_Store
.idea/
*.iml
.vscode/