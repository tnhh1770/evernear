# ==============================================================================
# Carely Mobile (Flutter / Dart) .gitignore
# ==============================================================================

# Miscellaneous & System
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
test_results.txt

# IntelliJ & Android Studio
*.iml
*.ipr
*.iws
.idea/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Flutter / Dart / Pub
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# Android Build Artifacts & Keystores
/android/app/debug
/android/app/profile
/android/app/release
key.properties
**/*.keystore
**/*.jks

# iOS Signing & Ephemeral
*.mobileprovision
*.cer
*.cert
*.p12
*.p8
AuthKey_*.p8

# Environment & Secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Widget Preview
.widget_preview/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
