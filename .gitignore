# ==============================================================================
# Carely Monorepo Root .gitignore
# ==============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE & Editor Directories / Files
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# AI Assistant & Tooling Local State
/.agents/
/.gemini/
/.claude/

# Temporary, Cache & Scratch Files
scratch/
tmp/
temp/
*.tmp
*.bak
.cache/

# Logs & Runtime
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Archives & Binaries
*.tar.gz
*.zip
*.7z
*.rar

# Environment & Secrets (Root fallback)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
